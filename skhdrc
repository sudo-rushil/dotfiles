## Inspired by https://github.com/FelixKratz/dotfiles/blob/e6288b3f4220ca1ac64a68e60fced2d4c3e3e20b/.config/skhd/skhdrc
# Space navigation
lalt - 1 : yabai -m space --focus 1
lalt - 2 : yabai -m space --focus 2
lalt - 3 : yabai -m space --focus 3
lalt - 4 : yabai -m space --focus 4

# Move to spaces
shift + lalt - 1 : yabai -m window --space 1
shift + lalt - 2 : yabai -m window --space 2
shift + lalt - 3 : yabai -m window --space 3
shift + lalt - 4 : yabai -m window --space 4

# Window navigation
shift + lalt - h : yabai -m window --focus west
shift + lalt - j : yabai -m window --focus south
shift + lalt - k : yabai -m window --focus north
shift + lalt - l : yabai -m window --focus east

launch < h : skhd -k "escape"; yabai -m space --focus prev
launch < l : skhd -k "escape"; yabai -m space --focus next

