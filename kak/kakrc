# powerline
plug "andreyorst/powerline.kak" defer powerline_palenight %{
    powerline-theme palenight
} defer powerline %{
	powerline-format global "mode_info git bufname filetype line_column position"
	set-option global powerline_separator_thin ""
	set-option global powerline_separator ""
} config %{
	powerline-start
}

plug 'delapouite/kakoune-mirror' %{
# Suggested mapping
  map global normal "'" ': enter-user-mode -lock mirror<ret>'
}

plug "gustavo-hms/luar" %{
    require-module luar
}

plug "gustavo-hms/peneira" %{
    require-module peneira
}

define-command peneira-buffers %{
    peneira 'buffers: ' %{ eval "printf '%s\n' $kak_quoted_buflist" } %{
        buffer %arg{1}
    }
}

map -docstring "open peneira buffers" global user b ": peneira-buffers<ret>"

# Buffer management
plug 'delapouite/kakoune-buffers' %{
    # use qwe for navigation, and b for buffers
    map global normal ^ q
    map global normal <a-^> Q
    map global normal q b
    map global normal Q B
    map global normal <a-q> <a-b>
    map global normal <a-Q> <a-B>
    map global normal b ': enter-buffers-mode<ret>' -docstring 'buffers'
    map global normal B ': enter-user-mode -lock buffers<ret>' -docstring 'buffers (lock)'
}

